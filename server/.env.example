# ═══════════════════════════════════════════════════════════════
# AI YouTube Shorts Generator — Local Configuration
# 100% Local AI — No API Keys Required
# ═══════════════════════════════════════════════════════════════

# ─── Ollama (Local LLM for highlight detection) ───
# URL where Ollama is running (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Model to use for highlight detection
# Recommended for 3-4GB RAM laptops:
#   - qwen2.5:3b    (~2GB) — Best balance of speed & quality
#   - qwen2.5:1.5b  (~1GB) — Faster, slightly less accurate
#   - tinyllama     (~600MB) — Fastest, basic quality
#   - phi3:mini     (~2.3GB) — Good quality, Microsoft model
#   - gemma2:2b     (~1.5GB) — Google's small model
OLLAMA_MODEL=qwen2.5:3b

# ─── Whisper (Local transcription) ───
# Model size for faster-whisper:
#   - tiny   (~75MB RAM)  — Fastest, lower accuracy
#   - base   (~150MB RAM) — Good balance (recommended)
#   - small  (~500MB RAM) — Better accuracy
#   - medium (~1.5GB RAM) — High accuracy
#   - large-v3 (~3GB RAM) — Best accuracy, slow on CPU
WHISPER_MODEL=base

# Python command (python3 on most systems, python on Windows)
PYTHON_CMD=python3

# ─── Server ───
PORT=3001
